<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="_sendJoint">
    <Code><![CDATA[begin
  jCurrent = herej()

  sioSet(siTcpIpJoint, jCurrent.j1)
  sioSet(siTcpIpJoint, jCurrent.j2)
  sioSet(siTcpIpJoint, jCurrent.j3)
  sioSet(siTcpIpJoint, jCurrent.j4)
  sioSet(siTcpIpJoint, jCurrent.j5)
  sioSet(siTcpIpJoint, jCurrent.j6)
end]]></Code>
  </Program>
</Programs>