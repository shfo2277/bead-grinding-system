<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="_alter_stauts">
    <Code><![CDATA[begin
  while true
    gotoxy(0,12)
    put("* nAlter: "+toString("",nAlter)+"   ")
    gotoxy(12,12)
    put("* nAlterBegin: "+toString("",nAlterBegin)+"   ")
    delay(1)
  endWhile
end]]></Code>
  </Program>
</Programs>