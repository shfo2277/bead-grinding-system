<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="_finish">
    <Code><![CDATA[begin
  // ============================================================================
  // CMD 1: 종료 - 홈 위치 복귀
  // ============================================================================
  cls()
  putln("[CMD 1] 종료 - 홈 복귀")
  nStatusSignal = 0
  call _sendStatus()
  
  movej(jHome, tTool, mNomSpeed)
  waitEndMove()
  
  putln("[CMD 1] 완료")
  bRunning = false
  
end]]></Code>
  </Program>
</Programs>