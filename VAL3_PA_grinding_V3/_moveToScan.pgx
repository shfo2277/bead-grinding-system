<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="_moveToScan">
    <Code><![CDATA[begin
  // ============================================================================
  // CMD 2: 스캔 위치로 이동
  // ============================================================================
  cls()
  putln("[CMD "+ toString("", nCmdSignal) +"] 스캔 위치로 이동")
  nStatusSignal = 0
  
  movej(j_scan, tTool, mNomSpeed)
  waitEndMove()
  
  putln("[CMD 2] 완료 - STATUS=1")
  nStatusSignal = 1
  
end]]></Code>
  </Program>
</Programs>