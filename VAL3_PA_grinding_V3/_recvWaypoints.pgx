<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="_recvWaypoints">
    <Locals>
      <Local name="l_nJ1" type="num" xsi:type="array" size="1" />
      <Local name="l_nJ2" type="num" xsi:type="array" size="1" />
      <Local name="l_nJ3" type="num" xsi:type="array" size="1" />
      <Local name="l_nJ4" type="num" xsi:type="array" size="1" />
      <Local name="l_nJ5" type="num" xsi:type="array" size="1" />
      <Local name="l_nJ6" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  // ============================================================================
  // CMD 3: 웨이포인트 수신 (TCP - Motion 소켓)
  // 데이터: DOC(float) + Force(float) + Count(float) + Joints(6 floats each)
  // Joint: j1, j2, j3, j4, j5, j6 (degrees)
  // ============================================================================
  cls()
  putln("[CMD "+ toString("", nCmdSignal) +"] 웨이포인트 수신 시작")
  nStatusSignal = 0
  
  // DOC 수신
  call _recvFloat(nDOC)
  
  // Force 수신
  call _recvFloat(nForceTarget)
  
  // Count 수신
  call _recvFloat(nWaypointCount)
  nWaypointCount = roundDown(nWaypointCount)
  
  putln("  DOC=" + toString("", nDOC))
  putln("  Force=" + toString("", nForceTarget))
  putln("  Count=" + toString("", nWaypointCount))
  
  // 각 Waypoint 수신 (6축 Joint)
  for i = 0 to nWaypointCount - 1
    call _recvFloat(l_nJ1)
    call _recvFloat(l_nJ2)
    call _recvFloat(l_nJ3)
    call _recvFloat(l_nJ4)
    call _recvFloat(l_nJ5)
    call _recvFloat(l_nJ6)
    
    jWaypoints[i].j1 = l_nJ1
    jWaypoints[i].j2 = l_nJ2
    jWaypoints[i].j3 = l_nJ3
    jWaypoints[i].j4 = l_nJ4
    jWaypoints[i].j5 = l_nJ5
    jWaypoints[i].j6 = l_nJ6
    
    putln("  J[" + toString("", i) + "]=" + toString("", l_nJ1) + "," + toString("", l_nJ2) + "," + toString("", l_nJ3) + "," + toString("", l_nJ4) + "," + toString("", l_nJ5) + "," + toString("", l_nJ6))
  endFor
  
  putln("[CMD 3] 완료")
  nStatusSignal = 3
  
end]]></Code>
  </Program>
</Programs>