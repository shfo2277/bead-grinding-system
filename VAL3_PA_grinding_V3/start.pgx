<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="start">
    <Code><![CDATA[begin
  // ============================================================================
  // PA_grinding_V3 - TCP 통신 버전 (3 소켓)
  // Command (11001): ROS2 -> 로봇, 명령 수신
  // Motion (11000): ROS2 -> 로봇, Waypoint/Joint 데이터
  // Feedback (11002): 로봇 -> ROS2, 상태 송신
  // ============================================================================
  
  userPage()
  cls()
  putln("=================================")
  putln("  PA_grinding_V3 Started")
  putln("=================================")
  putln("")
  
  // 초기화
  bRunning = true
  nLastCmd = 0
  nStatusSignal = 0
  nWaypointCount = 0
  nConnFlag = 0
  
  // 소켓 타임아웃 설정 (non-blocking)
  sioCtrl(siTcpIpCommand, "timeout", 0)
  sioCtrl(siTcpIpMotion, "timeout", 0)
  sioCtrl(siTcpIpFbk, "timeout", 0)
  
  // 버퍼 클리어
  clearBuffer(siTcpIpCommand)
  clearBuffer(siTcpIpMotion)
  clearBuffer(siTcpIpFbk)
  
  putln("TCP 소켓 준비 완료")
  putln("  - Command: 11001 (수신)")
  putln("  - Motion: 11000 (수신)")
  putln("  - Feedback: 11002 (송신)")
  putln("")
  putln("명령 대기 중...")
  putln("CMD: 1=종료, 2=스캔이동, 3=WP수신, 4=가공")
  putln("")
  
  // 메인 루프 태스크 시작
  taskCreate "mainLoop", 100, _mainLoop()
  
  // 메인 루프 종료 대기
  wait(taskStatus("mainLoop") == -1)
  
  cls()
  putln("PA_grinding_V3 종료됨")
  
end]]></Code>
  </Program>
</Programs>
